# Path to the netaudio binary
ALI_NETAUDIO_PATH=/path/to/netaudio

# Controller node name
ALI_DIST_NODE=alictr@resolvable-hostname

# Distribution cookie
ALI_DIST_COOKIE=dantes-inferno

# Interface name of Dante network
ALI_NET_IFACE=eth0

# Whether to enable the DHCP server
ALI_ENABLE_DHCP_SERVER=true
